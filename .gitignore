# Raw satellite and agency downloads. Every script that needs them fetches them,
# and the downloaders resume, so none of this belongs in version control.
raw/
**/raw/
*.h5
*.nc
*.nc4
*.hdf
*.zip

# Derived geometry, regenerated by global/scripts/02_basins.py in one command.
*.gpkg
*.shp
*.shx
*.dbf
*.sbn
*.sbx
*.prj

# Large intermediates
**/processed/*.parquet
**/tmp/pylibs/
__pycache__/
*.pyc

# Credentials never belong here. The Earthdata token is read from the path in
# EARTHDATA_TOKEN_FILE and is not part of this repository.
*.netrc
_netrc
earthdata*.txt
.env
